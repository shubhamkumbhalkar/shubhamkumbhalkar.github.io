---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import AudienceChooser from '../components/AudienceChooser.astro';
import ExternalLink from '../components/ExternalLink.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactBlock from '../components/ContactBlock.astro';
import {
  caseStudies,
  caseStudiesBySlug,
  contact,
  formatDate,
  home,
  profile,
  publications,
  writing,
} from '../data';
import { writingSchemas } from '../lib/structured-data';

const selectedWork = caseStudiesBySlug(home.selectedWork);

// Writing preview: dated articles, newest first, then the most recent paper.
const datedArticles = writing.articles
  .filter((article) => article.published)
  .sort((a, b) => (b.published ?? '').localeCompare(a.published ?? ''));
const latestPaper = [...publications].sort((a, b) => b.year.localeCompare(a.year))[0];
---

<Base
  title={`${profile.name} | ${profile.jobTitle}`}
  description={profile.metaDescription}
  structuredData={writingSchemas()}
>
  <section class="intro" aria-labelledby="intro-heading">
    <div class="container intro__grid">
      <div class="intro__text">
        <p class="eyebrow">{home.eyebrow}</p>
        <h1 id="intro-heading">{profile.name}</h1>
        <p class="intro__statement">{home.statement}</p>
        <p class="intro__links">
          <a href="#paths">Choose a path</a>
          <a href="#contact">Contact</a>
          <a href={profile.resume} download>Resume (PDF)</a>
        </p>
      </div>
      <picture class="intro__photo">
        <source srcset={profile.headshot.webp} type="image/webp" />
        <img
          src={profile.headshot.png}
          alt={profile.headshot.alt}
          width={profile.headshot.width}
          height={profile.headshot.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </section>

  <AudienceChooser />

  <Section id="evidence" title={home.evidence.heading}>
    <dl class="evidence">
      {
        home.evidence.items.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>
              <p>{item.text}</p>
              <ExternalLink link={item.link} />
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section id="work" title="Selected work">
    <ol class="preview">
      {
        selectedWork.map((study) => (
          <li>
            <p class="meta">
              {study.organization} · {study.period}
            </p>
            <h3>
              <a href={`/work/${study.slug}/`}>{study.title}</a>
            </h3>
            {study.results[0] ? (
              <p class="preview__result">
                <strong>{study.results[0].value}</strong> {study.results[0].label}
              </p>
            ) : (
              <p class="preview__result">{study.summary}</p>
            )}
          </li>
        ))
      }
    </ol>
    <p class="onward"><a href="/work/">All {caseStudies.length} case studies</a></p>
  </Section>

  <Section id="writing" title="Writing and research">
    <ol class="preview">
      {
        datedArticles.map((article) => (
          <li>
            <p class="meta">
              {article.venue} · <time datetime={article.published}>{formatDate(article.published ?? '')}</time>
            </p>
            <h3>
              <a href={article.url} target="_blank" rel="noopener">
                {article.title}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </h3>
          </li>
        ))
      }
      {
        latestPaper && (
          <li>
            <p class="meta">
              {latestPaper.venue} · {latestPaper.year} · {latestPaper.status}
            </p>
            <h3>
              {latestPaper.link ? (
                <a href={latestPaper.link.url} target="_blank" rel="noopener">
                  {latestPaper.title}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              ) : (
                latestPaper.title
              )}
            </h3>
          </li>
        )
      }
    </ol>
    <p class="onward"><a href="/writing/">All writing, research and talks</a></p>
  </Section>

  <Section id="contact" title="Get in touch" intro={contact.intro}>
    <ContactForm />
    <p class="meta">{contact.directLabel}</p>
    <ContactBlock />
  </Section>
</Base>

<style>
  .intro {
    padding: var(--space-8) 0 var(--space-8);
  }

  .intro__grid {
    display: grid;
    gap: var(--space-5);
  }

  .intro__photo {
    order: -1;
  }

  .intro__photo img {
    width: 6rem;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .intro__statement {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.3;
    font-weight: 500;
    color: var(--color-text);
    max-width: 30ch;
    margin-bottom: var(--space-6);
  }

  .intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
  }

  .intro__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .intro {
      padding: var(--space-9) 0 var(--space-8);
    }

    .intro__grid {
      grid-template-columns: minmax(0, 9fr) minmax(0, 3fr);
      gap: var(--space-7);
      align-items: end;
    }

    .intro__photo {
      order: 0;
    }

    .intro__photo img {
      width: 100%;
      max-width: 16rem;
      margin-left: auto;
    }
  }

  .evidence {
    margin: 0;
    display: grid;
  }

  .evidence div {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }

  .evidence div:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .evidence dt {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .evidence dd {
    margin: 0;
  }

  .evidence dd p {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.45;
    margin-bottom: var(--space-2);
  }

  @media (min-width: 640px) {
    .evidence div {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  .preview {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .preview > li {
    max-width: none;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
  }

  .preview > li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .preview h3 {
    margin-bottom: var(--space-2);
  }

  .preview .meta {
    margin-bottom: var(--space-1);
  }

  .preview__result {
    margin: 0;
    color: var(--color-secondary);
  }

  @media (prefers-color-scheme: dark) {
    .preview__result {
      color: var(--color-muted);
    }
  }
</style>
