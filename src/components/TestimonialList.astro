---
import { testimonials } from '../data';
---

<ul class="entry-list testimonials">
  {
    testimonials.map((item) => (
      <li>
        <figure class="quote">
          <blockquote>
            <p>“{item.quote}”</p>
          </blockquote>
          <figcaption>
            <strong>{item.name}</strong>
            <span>{item.role}</span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .quote {
    margin: 0;
  }

  .quote blockquote {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .quote figcaption {
    display: grid;
  }

  .quote figcaption span {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
